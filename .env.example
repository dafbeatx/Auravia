# Supabase Configuration
# URL proyek Supabase Anda (contoh: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public API Key Supabase (Aman digunakan pada browser sisi klien)
# DILARANG KERAS memasukkan SERVICE_ROLE_KEY di sini!
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
